# Gemma 4 12B instruct, bf16; thinking on by default for chat.
PROFILE=gemma-4-12b
HF_MODEL=google/gemma-4-12B-it
HF_REVISION=707f0a3b8a3c7ad586ed01e27eafbad8a27dd0f7
SERVED_MODEL=gemma-4-12b
# Chat context 65k (DS-017). A long chat prefill takes every step and stalls decisions until done (DS-025).
# Decisions get the whole window: the Index's longest request is 53,928 tokens (submission, 2026-10-15).
MAX_MODEL_LEN=65536
SYSTEMONE_MAX_LEN=65536
MAX_NUM_SEQS=256
REASONING_PARSER=gemma4
TOOL_PARSER=gemma4
# Vision kept for image chat: language-model-only frees no KV cache (DS-011).
LANGUAGE_MODEL_ONLY=0
# Decisions take up to 4 images, each <=560 soft tokens; the gateway counts them with the same kwargs.
# Image rows read up to 128 sample logprobs, so EXTRA_ARGS raises vLLM's --max-logprobs (default 20).
SYSTEMONE_IMAGES=1
MM_PROCESSOR_KWARGS={"max_soft_tokens":560}
CHAT_TEMPLATE=/vllm-workspace/examples/tool_chat_template_gemma4.jinja
CHAT_TEMPLATE_KWARGS={"enable_thinking": true}
PROMPT_LAYOUT=blurb_header
OPTION_ORDERS=top_p:0.9+reversed
OPTION_ORDERS_IMAGES=identity
PREFIX_BLOCK=0
PREFIX_PAD=off
# Retention 64 (the 12B scheduler block is 64) hashes sliding-window blocks along each prompt so prefixes are reusable (DS-015).
# A long chat prefill takes <=1024 tokens a step (DS-025). Video off: a video item (2,496 tokens) never fits; images (<=560) do.
EXTRA_ARGS=--prefix-cache-retention-interval 64 --limit-mm-per-prompt {"video":0,"image":4} --long-prefill-token-threshold 1024 --max-logprobs 128
# Chunked prefill (1,024 a step) makes rows sent together recompute the shared state; send it alone first
# when it is >= 4,096 tokens (8k x 16: 2.90x -> 0.99x computed, 8.2 -> 3.1 s; at 2k it cost req/s under load).
WARM_UP=prefix
WARM_MIN_PREFIX_TOKENS=4096
# While a chat streams, decisions go 8 rows at a time with ~50% of the time (DS-007 governor).
GOVERNOR_DUTY=0.5
GOVERNOR_WAVE=8
