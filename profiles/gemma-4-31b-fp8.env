# Gemma 4 31B instruct, FP8 weights + fp8 KV (DS-005); base gemma-4-31b. Start: docker compose --env-file profiles/gemma-4-31b-fp8.env up -d
PROFILE=gemma-4-31b-fp8
HF_MODEL=RedHatAI/gemma-4-31B-it-FP8-block
HF_REVISION=d7242548c457ab4b45bd3adb8937f2659af4739d
SERVED_MODEL=gemma-4-31b-fp8
# Chat context 65k (DS-017). A long chat prefill takes every step and stalls decisions until done (DS-025).
# Decisions keep their own 32k cap so selection limits never move.
MAX_MODEL_LEN=65536
SYSTEMONE_MAX_LEN=32768
MAX_NUM_SEQS=256
REASONING_PARSER=gemma4
TOOL_PARSER=gemma4
# Vision kept for image chat: language-model-only frees no KV cache (DS-011).
LANGUAGE_MODEL_ONLY=0
CHAT_TEMPLATE=/vllm-workspace/examples/tool_chat_template_gemma4.jinja
CHAT_TEMPLATE_KWARGS={"enable_thinking": true}
PROMPT_LAYOUT=header
OPTION_ORDERS=identity
PREFIX_BLOCK=0
PREFIX_PAD=off
# Retention 32 hashes sliding-window blocks along each prompt so prefixes are reusable (DS-015).
# A long chat prefill takes <=1024 tokens a step (DS-025). Video off: a video item (2,496 tokens) never fits; images (<=280) do.
# fp8 KV with per-token-head scales: 1.55x KV tokens, no query cast (DS-005).
EXTRA_ARGS=--prefix-cache-retention-interval 32 --limit-mm-per-prompt {"video":0} --long-prefill-token-threshold 1024 --kv-cache-dtype fp8_per_token_head
# Chunked prefill (1,024 a step) makes rows sent together recompute the shared state; send it alone first
# when it is >= 1,024 tokens (2026-10-15 probe: 8k x 16 went 2.90x -> 0.99x computed, 8.2 -> 3.1 s).
WARM_UP=prefix
WARM_MIN_PREFIX_TOKENS=1024
# While a chat streams, decisions go 8 rows at a time with ~50% of the time (DS-007 governor).
GOVERNOR_DUTY=0.5
GOVERNOR_WAVE=8
# DeepGEMM crashes on sm_120 (vLLM #51884, #60261).
VLLM_USE_DEEP_GEMM=0
