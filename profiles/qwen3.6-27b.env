# Qwen3.6-27B, bf16. Start: docker compose --env-file profiles/qwen3.6-27b.env up -d
PROFILE=qwen3.6-27b
HF_MODEL=Qwen/Qwen3.6-27B
HF_REVISION=6a9e13bd6fc8f0983b9b99948120bc37f49c13e9
SERVED_MODEL=qwen3.6-27b
# Chat context: native context for coding agents (DS-016). Decisions keep their own 32k cap so selection limits never move.
MAX_MODEL_LEN=262144
SYSTEMONE_MAX_LEN=32768
MAX_NUM_SEQS=256
REASONING_PARSER=qwen3
TOOL_PARSER=qwen3_coder
LANGUAGE_MODEL_ONLY=1
CHAT_TEMPLATE=
CHAT_TEMPLATE_KWARGS=
PROMPT_LAYOUT=blurb_header_reread
OPTION_ORDERS=identity
# MTP makes hybrid Qwen cache blocks 800 tokens (784 without): pad shared prefixes to the block size (DS-004, DS-008).
PREFIX_BLOCK=800
WARM_MIN_PREFIX_TOKENS=800
WARM_UP=row
PREFIX_PAD=front
# Long chat prefills take <=800 tokens a step (one MTP block), leaving room for decisions; chat goes first (DS-025, DS-007).
# MTP on (DS-004); to turn it off, delete --speculative-config and set PREFIX_BLOCK and
# WARM_MIN_PREFIX_TOKENS to 784 (the gateway then loads calibration-784.json).
EXTRA_ARGS=--long-prefill-token-threshold 800 --max-num-batched-tokens 2400 --scheduling-policy priority --speculative-config {"method":"mtp","num_speculative_tokens":3,"disable_eagle_block_drop":true}
SYSTEMONE_PRIORITY=1
# While a chat streams, decisions go 8 rows at a time with ~60% of the time (DS-007 governor).
GOVERNOR_DUTY=0.6
GOVERNOR_WAVE=8
