# Qwen3.8-27B, FP8 weights (DS-005); base qwen3.8-27b. Start: docker compose --env-file profiles/qwen3.8-27b-fp8.env up -d
PROFILE=qwen3.8-27b-fp8
HF_MODEL=Qwen/Qwen3.8-27B-FP8
HF_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
SERVED_MODEL=qwen3.8-27b-fp8
# Chat context: native context for coding agents (DS-016). Decisions keep their own 32k cap so selection limits never move.
MAX_MODEL_LEN=262144
SYSTEMONE_MAX_LEN=32768
MAX_NUM_SEQS=256
REASONING_PARSER=qwen3
TOOL_PARSER=qwen3_xml
# Vision on for image decisions: up to 4 images, each capped at 1,638,400 pixels (1,600 tokens).
# Image rows read up to 128 sample logprobs, so EXTRA_ARGS raises vLLM's --max-logprobs (default 20).
LANGUAGE_MODEL_ONLY=0
SYSTEMONE_IMAGES=1
MM_PROCESSOR_KWARGS={"max_pixels":1638400}
CHAT_TEMPLATE=
CHAT_TEMPLATE_KWARGS=
PROMPT_LAYOUT=blurb_header_reread
OPTION_ORDERS=min_n:4+reversed
# MTP makes hybrid Qwen cache blocks 800 tokens (784 without): pad shared prefixes to the block size (DS-004, DS-008).
PREFIX_BLOCK=800
WARM_MIN_PREFIX_TOKENS=800
WARM_UP=row
PREFIX_PAD=front
# Long chat prefills take <=800 tokens a step (one MTP block), leaving room for decisions; chat goes first (DS-025, DS-007).
# MTP on (DS-004); to turn it off, delete --speculative-config and set PREFIX_BLOCK and
# WARM_MIN_PREFIX_TOKENS to 784, then collect and fit a calibration-784.json (none yet).
# #49010: fp8 KV + MTP corrupts output on sm_120; the checkpoint's kv_cache_scheme would pick fp8.
EXTRA_ARGS=--long-prefill-token-threshold 800 --max-num-batched-tokens 2400 --scheduling-policy priority --limit-mm-per-prompt {"video":0,"image":4} --speculative-config {"method":"mtp","num_speculative_tokens":3,"disable_eagle_block_drop":true} --max-logprobs 128 --kv-cache-dtype bfloat16
SYSTEMONE_PRIORITY=1
# While a chat streams, decisions go 8 rows at a time with ~60% of the time (DS-007 governor).
GOVERNOR_DUTY=0.6
GOVERNOR_WAVE=8
# DeepGEMM crashes on sm_120 (vLLM #51884, #60261).
VLLM_USE_DEEP_GEMM=0
